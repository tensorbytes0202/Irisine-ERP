# ─── Database ──────────────────────────────────────────
DATABASE_URL="mysql://mis_user:mis_password@localhost:3308/mis_ilsms"
DB_USER=mis_user
DB_PASSWORD=mis_password
DB_ROOT_PASSWORD=root_password
DB_NAME=mis_ilsms

# ─── Auth ──────────────────────────────────────────────
JWT_SECRET=change-this-to-a-secure-random-string
JWT_REFRESH_SECRET=change-this-to-another-secure-random-string

# ─── API ───────────────────────────────────────────────
PORT=4000
CORS_ORIGIN=http://localhost:3000

# ─── Frontend ──────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# ─── Redis ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── MinIO / S3 ───────────────────────────────────────
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=mis-uploads

# Password for the seed admin (required to run prisma/seed.ts)
ADMIN_SEED_PASSWORD=
# Public sign up is OFF unless this is exactly true
ALLOW_SIGNUP=false

# --- Razorpay (use TEST keys first: rzp_test_...) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Email (Resend). EMAIL_FROM must be on a domain verified in Resend ---
RESEND_API_KEY=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# --- Email one-time codes ---
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
